# Copy this file to .env and fill in your real values.
PORT=3000

BUSINESS_NAME=Your Shop Name
BUSINESS_PHONE=+910000000000
CURRENCY_SYMBOL=₹
GOOGLE_REVIEW_LINK=https://g.page/r/YOUR_GOOGLE_REVIEW_ID/review
ADMIN_PASSWORD=change-this-admin-password

# Supabase storage. Use the service role key on the server only.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# SMS Gateway for Android / SMSGate cloud API.
SMSGATE_BASE_URL=https://api.sms-gate.app/3rdparty/v1/messages
SMSGATE_USERNAME=your-smsgate-username
SMSGATE_PASSWORD=your-smsgate-password
SMSGATE_DEVICE_ID=your-device-id
SMSGATE_SIM_NUMBER=1
SMSGATE_PRIORITY=100
SMSGATE_SKIP_PHONE_VALIDATION=false
SMSGATE_DEVICE_ACTIVE_WITHIN=
